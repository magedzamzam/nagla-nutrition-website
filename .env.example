# ============================================================
# Production environment for Dr. Nagla website
# Copy this file to `.env` and fill in real values before deploying
# ============================================================

# Public URL — used in canonical tags, sitemap, OG tags
PUBLIC_URL=https://drnaglanutrition.com

# Admin credentials — used to seed the admin user on first run
# Change these BEFORE first boot. After first boot, change via admin UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-StrongPass-2026!

# JWT signing secret — generate a long random string
# Run: openssl rand -base64 64
JWT_SECRET=replace-me-with-a-long-random-string-at-least-64-characters-long
